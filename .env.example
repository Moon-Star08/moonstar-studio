# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Port the server listens on
PORT=3000

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Set to "production" when deploying (enables secure cookies behind HTTPS)
NODE_ENV=development

# ---- Contact form email notifications (optional) ----
# When set, each new contact message is emailed to you (it also still saves to
# the admin inbox). Leave blank to disable. For Gmail: turn on 2-Step
# Verification, create an App Password, and use it as SMTP_PASS below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
# Where to receive the notifications (defaults to SMTP_USER if omitted)
CONTACT_NOTIFY_TO=your-address@gmail.com
