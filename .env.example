# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Port the server listens on
PORT=3000

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Set to "production" when deploying (enables secure cookies behind HTTPS)
NODE_ENV=development

# ---- Transactional email (Resend) ----
# Get an API key at https://resend.com (API Keys). Also add this same key in
# Render → your service → Settings → Environment. Never commit the real key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Workout tracker ----
# Friends need this code to create an account at /workout. Change it to
# anything you like and only share it with people you want to let in.
WORKOUT_INVITE_CODE=MOONSTAR-FIT

# Where the SQLite database file lives. Point this at a Render persistent disk
# (e.g. /var/data) so accounts, plans and progress survive redeploys. If left
# unset it falls back to a local ./data folder (fine for development).
# DATA_DIR=/var/data

# ---- Contact form email notifications (optional) ----
# When set, each new contact message is emailed to you (it also still saves to
# the admin inbox). Leave blank to disable. For Gmail: turn on 2-Step
# Verification, create an App Password, and use it as SMTP_PASS below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
# Where to receive the notifications (defaults to SMTP_USER if omitted)
CONTACT_NOTIFY_TO=your-address@gmail.com

# ---- Google sign-in for visitors (optional) ----
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console. Add the
# authorized redirect URI: https://YOUR-DOMAIN/api/account/google/callback
# The "Continue with Google" button stays hidden until both of these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the callback host differs from the request host (e.g. behind a
# proxy). Otherwise the callback URL is derived automatically.
# OAUTH_CALLBACK_BASE=https://moonstarstudio.site
